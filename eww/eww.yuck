(defvar show_alt false)

(defpoll time :interval "1s"
  :initial "00:00"
  `date +%R`)

(defpoll datetime :interval "1s"
  :initial "YYYY-MM-DD HH:MM:SS"
  `date "+%d-%b %R"`)

(defwindow time-widget
  :monitor 0
  :geometry (geometry :anchor "top right")
  :stacking "fg"
  :exclusive "false"
  :focusable "none"
  (time-display))

(defwidget time-display []
  (box :orientation "horizontal"
       :halign "end"
       :class "time-container"
    (button
      :onclick "eww update show_alt=${!show_alt}"
      (label
        :text {show_alt ? datetime : time}
        :class "time-text"
      )
    )
  )
)

(defwindow power-widget
  :monitor 0
  :geometry (geometry :anchor "bottom right")
  :stacking "bg"
  :exclusive "false"
  :focusable "none"
  (power-controls)
)

(defwidget power-controls []
  (box :class "power-controls-container" :orientation "horizontal" :spacing 6 :halign "center" :valign "center"
    (button
      :class "power-button"
      :onclick "bash ${EWW_CONFIG_DIR}/shutdown.sh"
      (image :path "/usr/share/icons/Papirus/16x16/actions/system-reboot.svg" :width 32 :height 32)
    )
    (button
      :class "power-button"
      :onclick "bash ${EWW_CONFIG_DIR}/reboot.sh"
      (image :path "/usr/share/icons/Papirus/16x16/actions/system-shutdown.svg" :width 32 :height 32)
    )
  )
)
