(defwindow time-widget
  :monitor 0
  :geometry (geometry :anchor "top right")
  :stacking "fg"
  :exclusive "true"
  :focusable "none"
  (time-display))

(defpoll datetime :interval "1s"
  :initial "00:00"
  `date "+%a %b %d, %H:%M:%S"`)

(defwidget time-display []
  (box :class "time-container"
       :orientation "horizontal"
       :space-evenly false
       :halign "end"
    (label :class "time-text" :text datetime)))

(defwindow power-widget
  :monitor 0
  :geometry (geometry :anchor "bottom right")
  :stacking "bg"
  :exclusive "true"
  :focusable "none"
  (power-controls)
)

(defwidget power-controls []
  (box :orientation "horizontal" :spacing 10 :halign "center" :valign "center"
    (button
      :tooltip "Reboot"
      :onclick "bash ~/.config/eww/reboot.sh"
      (image :path "/usr/share/icons/Papirus/24x24/actions/system-reboot.svg" :width 32 :height 32)
    )
    (button
      :tooltip "Poweroff"
      :onclick "bash ~/.config/eww/shutdown.sh"
      (image :path "/usr/share/icons/Papirus/24x24/actions/system-shutdown.svg" :width 32 :height 32)
    )
  )
)
