set selection-clipboard clipboard
set font "JetBrains Mono 20"
set double-click-follow true
#
map <C-Button4> zoom in
map <C-Button5> zoom out
map <C-=> zoom in
map <C--> zoom out

# map <C-i> toggle_index

# map <C-d> set "first-page-column 1:2"


# Zathura configuration file
# See man `man zathurarc'

# Open document in fit-width mode by default
set adjust-open "best-fit"

# One page per row by default
set pages-per-row 1

#stop at page boundries
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100

#zoom settings
set zoom-min 10

set render-loading "false"
set scroll-step 50
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen


# zathurarc-dark-modern

# Main colors
set default-bg            "#0D0D0D"   # background
set default-fg            "#EAEAEA"   # foreground text

# Status bar
set statusbar-bg          "#1A1A1A"
set statusbar-fg          "#B8B8B8"

# Input bar
set inputbar-bg           "#151515"
set inputbar-fg           "#FFFFFF"

# Notifications
set notification-error-bg    "#FF5F5F"
set notification-error-fg    "#1A1A1A"

set notification-warning-bg  "#FFB84D"
set notification-warning-fg  "#1A1A1A"

set notification-bg          "#4DA6FF"
set notification-fg          "#0D0D0D"

# Highlights
set highlight-color          "#FFD369"   # yellow accent
set highlight-active-color   "#5F9EA0"   # teal accent

# Completion menu
set completion-bg            "#2A2A2A"
set completion-fg            "#D0D0D0"
set completion-highlight-bg  "#5FD787"
set completion-highlight-fg  "#0D0D0D"

# Recoloring for PDFs
set recolor                  "true"
set recolor-lightcolor       "#0D0D0D"
set recolor-darkcolor        "#EAEAEA"
set recolor-reverse-video    "true"
set recolor-keephue          "true"


